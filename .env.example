# ArchFlow configuration. Copy to .env and fill in what you need; everything is optional for local dev.

# ---- Storage -------------------------------------------------------------
# Postgres (production). If unset or not a postgres:// / postgresql:// URL, SQLite is used.
# Local: docker compose up -d postgres  ->  postgresql://archflow:<POSTGRES_PASSWORD>@localhost:5432/archflow
# Password for the local Postgres container (docker compose reads it from this file). Use a random value.
POSTGRES_PASSWORD=
DATABASE_URL=
# SQLite file path used when DATABASE_URL is not set (default: backend/data/archflow.db; ":memory:" for tests).
ARCHFLOW_DB=
# Redis (realtime fan-out / caching). Local: redis://localhost:6379/0
REDIS_URL=

# ---- AI providers --------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AI mode, e.g. "offline" to use the built-in rule-based engine with no API calls.
ARCHFLOW_AI=
# Model overrides (provider/model ids) for heavy reasoning and fast/cheap calls.
ARCHFLOW_MODEL_REASONING=
ARCHFLOW_MODEL_FAST=

# ---- Architecture decisions ----------------------------------------------
# ---- Observability (Langfuse) --------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---- Tests ---------------------------------------------------------------
# Enables the Postgres half of backend/tests/test_store.py.
TEST_DATABASE_URL=

# ---- Real-time collaboration --------------------------------------------
# Where the API pushes server-side edits (AI, MCP, restore) into live documents. Empty disables it.
ARCHFLOW_COLLAB_URL=http://localhost:1234
# Shared secret between the API and the collab server. Change it in any shared environment.
ARCHFLOW_INTERNAL_TOKEN=
# Collab server settings (read by collab/src/server.ts).
COLLAB_PORT=1234
ARCHFLOW_API=http://localhost:8000

# ---- Remote MCP server / OAuth -------------------------------------------
# Public base URL of the API (issuer and MCP resource URL are derived from it). Must be HTTPS for Claude.ai.
ARCHFLOW_PUBLIC_URL=http://localhost:8000
# Extra Host names allowed to reach /mcp (comma-separated), e.g. your tunnel or domain.
ARCHFLOW_MCP_ALLOWED_HOSTS=
ARCHFLOW_ACCESS_TOKEN_TTL=3600
ARCHFLOW_REFRESH_TOKEN_TTL=2592000

# ---- Accounts, sessions and security -------------------------------------
# Browser origins allowed to call the API with the session cookie (CORS + CSRF check), comma-separated.
# The origin of ARCHFLOW_PUBLIC_URL is always allowed. Default: http://localhost:5173 (the Vite dev server).
ARCHFLOW_ALLOWED_ORIGINS=
# Key for encrypting organizations' own AI provider keys at rest (AES-256-GCM). Any long random string,
# e.g. the output of `openssl rand -base64 32`. Without it, the "AI keys" settings are disabled (HTTP 503).
# Changing it makes stored org keys unreadable (admins re-enter them). Never commit a real value.
ARCHFLOW_SECRET_KEY=
# "false" = sign-up by invite link only (the very first account is always allowed). Default: open sign-up.
ARCHFLOW_OPEN_SIGNUP=

# ---- Repository analysis (optional: cd backend && uv sync --extra codegraph) ----
# "1" lets developers analyse directories on the API server (local_path). Self-hosted/dev only.
ARCHFLOW_ALLOW_LOCAL_REPOS=
# Seconds the analysis worker process may run (default 600).
ARCHFLOW_CODEGRAPH_TIMEOUT=

# Analysing Git URLs pins DNS to the vetted address, which needs git 2.37+ on the server. With older git the API
# refuses URL analysis unless this is set — only do that on a developer machine (DNS-rebinding risk).
# ARCHFLOW_ALLOW_UNPINNED_GIT=1

# ---- AI spend ---------------------------------------------------------------
# USD per million (input, output) tokens for models LiteLLM has no price for, matched as substrings, e.g.
# ARCHFLOW_LLM_PRICES={"gemini-3.1-pro": [2.0, 12.0]}
ARCHFLOW_LLM_PRICES=

# ---- Production compose (docker-compose.prod.yml) ---------------------------
# Leave empty to build the API image without repository analysis (smaller).
ARCHFLOW_BUILD_EXTRAS=codegraph
ARCHFLOW_HTTP_PORT=8080

# ---- AI providers configured in the UI (AI settings) ---------------------------
# Organization admins add keys and choose models per organization in the app; these server-wide keys are the
# defaults for organizations that configure nothing. Any of: OPENROUTER_API_KEY, MISTRAL_API_KEY, GROQ_API_KEY,
# DEEPSEEK_API_KEY, XAI_API_KEY (Gemini, Anthropic and OpenAI keys are above).
# Allow model endpoints on private/loopback addresses (a local Ollama or vLLM). Keep false on a shared server.
ARCHFLOW_ALLOW_PRIVATE_AI_URLS=true
