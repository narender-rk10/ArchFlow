# ArchFlow edge: the web app plus the routes the Vite dev proxy provides in development.
# ${API_UPSTREAM} and ${COLLAB_UPSTREAM} are filled in by the nginx image at start (envsubst).
# TLS is expected in front (load balancer, Caddy, Cloudflare); set ARCHFLOW_PUBLIC_URL to the https:// origin.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Keep the scheme set by a TLS terminator in front; otherwise use this hop's.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    client_max_body_size 60m;          # uploaded code graphs and reports

    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location = /healthz { access_log off; return 200 "ok\n"; }

    # API, OAuth and MCP (server-sent events for streamed answers: no buffering, long reads).
    location ~ ^/(api|oauth|mcp|authorize|token|register|revoke|\.well-known)(/|$) {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Live events (AI status, versions, conversations) from the API.
    location /ws/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }

    # Real-time collaboration (Hocuspocus); the browser connects to /collab.
    location /collab {
        rewrite ^/collab/?(.*)$ /$1 break;
        proxy_pass ${COLLAB_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Hashed build assets: cache for a year. The app shell: never cache.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
